<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ShopStream.DabHost</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.DataApiBuilder" HintPath="$(DabToolDirectory)/Microsoft.DataApiBuilder.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckDabTool" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DabToolDirectory)/Microsoft.DataApiBuilder.dll')" Text="Build through DabBackend.csproj to resolve the pinned official DAB assemblies." />
  </Target>
</Project>
