# Copy to .env; use node --env-file=.env server/index.js.
# Plain npm scripts do not load .env. See README for bootstrap/grant/testing.
# Local SQL needs an approved exact-IP firewall rule and a limited developer user.
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=shopstream
SQL_PORT=1433
# Local DefaultAzureCredential: az login --tenant <tenant>, then az account set.
# Remove unrelated AZURE_CLIENT_SECRET / service principal env vars first.
ENTRA_CREDENTIAL=default
# Hosted: ENTRA_CREDENTIAL=managed-identity; AZURE_CLIENT_ID unset for system-assigned.
# Builder named connections can supply SQL_CONNECTION_STRING instead of SQL_SERVER/SQL_DATABASE/SQL_PORT.
# If using SQL_CONNECTION_STRING, remove all three SQL routing settings above.
SHOPSTREAM_ENABLE_DEMO_WRITES=false
# SHOPSTREAM_ENABLE_DEMO_WRITES=true enables unauthenticated, bounded DEV/TEST writes.
# Integration tests require a separate disposable seeded DB and explicit opt-in;
# do not target the deployed demo. See README; never save the test opt-in here.
# SHOPSTREAM_PUBLIC_ORIGIN=https://your-app.app.westus2.builderapps.dev
# Use the exact public HTTPS origin with no trailing slash; never trust forwarded headers.
